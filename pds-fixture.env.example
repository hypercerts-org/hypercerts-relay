# Copy to .env.pds.fixture and replace every value locally. Do not commit that file.
# Each hostname must have a separately routed named Cloudflare Tunnel before a
# PDS account is created. Quick Tunnel hostnames are deliberately unsupported.
PDS_A_HOSTNAME=pds-a.fixture.example
PDS_B_HOSTNAME=pds-b.fixture.example

# Point both values at an isolated PLC service that supports PDS account/DID
# creation and later DID resolution. Do not use plc.directory when the test
# requires disposable identities.
PDS_A_DID_PLC_URL=https://plc.fixture.example
PDS_B_DID_PLC_URL=https://plc.fixture.example

# Generate distinct local values. These placeholders deliberately prevent use.
PDS_A_JWT_SECRET=replace-with-a-random-secret
PDS_A_ADMIN_PASSWORD=replace-with-a-random-password
PDS_A_PLC_ROTATION_KEY_K256_PRIVATE_KEY_HEX=replace-with-a-k256-private-key
PDS_A_TUNNEL_TOKEN=replace-with-a-named-tunnel-token
PDS_B_JWT_SECRET=replace-with-a-random-secret
PDS_B_ADMIN_PASSWORD=replace-with-a-random-password
PDS_B_PLC_ROTATION_KEY_K256_PRIVATE_KEY_HEX=replace-with-a-k256-private-key
PDS_B_TUNNEL_TOKEN=replace-with-a-named-tunnel-token
